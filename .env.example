# Copy to .env.local and fill in. Both values are PUBLIC client identifiers and
# are meant to ship in the bundle. The real secrets — the Gemini key and the
# Turnstile secret — live in the Worker, set via `wrangler secret put`.

# Your deployed Worker. Leave blank in local dev to use the Vite proxy instead.
VITE_CHAT_API_URL=https://portfolio-chat.YOUR-SUBDOMAIN.workers.dev

# Cloudflare dashboard → Turnstile → add site → copy the SITE key (0x4AAA...)
VITE_TURNSTILE_SITE_KEY=
